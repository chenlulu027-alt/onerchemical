# ========== Site ==========
NEXT_PUBLIC_SITE_URL=https://onerchemical.com

# ========== Resend ==========
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# Verified sender domain, e.g. "Onerchemical <noreply@onerchemical.com>"
RESEND_FROM=Onerchemical <noreply@onerchemical.com>
# Internal address to receive lead notifications
LEAD_NOTIFY_TO=sales@onerchemical.com

# ========== Microsoft Clarity ==========
# Get from https://clarity.microsoft.com (project ID like "abc123xyz")
NEXT_PUBLIC_CLARITY_ID=

# ========== Honeypot ==========
# Optional: shared secret header for admin endpoints (not used in Phase 0)
# ADMIN_SECRET=
